# NEWSWIRE backend configuration
# Copy to .env and fill in the values for the provider you want to use.

# ── AI provider ──────────────────────────────────────────────────────────────
# Which backend generates tickers:
#   gemini        — Google Gemini API (GEMINI_API_KEY below)
#   openai_compat — any OpenAI-compatible endpoint (OpenRouter, Groq, Mistral, ...)
AI_PROVIDER=gemini

# ── Gemini (active when AI_PROVIDER=gemini) ─────────────────────────────────
# Free-tier request quotas reset daily at midnight Pacific time.
GEMINI_API_KEY=
# gemini-2.5-flash is retired for new API keys.
# Verified working models as of Oct 2026: gemini-3.5-flash (fast), gemini-3.8-flash (often overloaded)
GEMINI_MODEL=gemini-3.5-flash

# ── OpenAI-compatible endpoint (active when AI_PROVIDER=openai_compat) ──────
# Example: OpenRouter free models (no credit card — key at https://openrouter.ai/keys).
# Free models share contended upstream pools, so a fallback chain is set:
# primary first, then the comma-separated fallbacks in order.
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_COMPAT_FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# ── Transient error retry ────────────────────────────────────────────────────
# Applied to 429 rate limits, 5xx overload ("high demand"), and timeouts.
# Backoff is exponential with jitter; rate-limit reset hints are honored.
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY=1.0
AI_RETRY_MAX_WAIT=70.0

# Cap on simultaneous provider calls. OpenRouter's free tier allows
# 20 free-model requests per minute — keep this well below it.
AI_MAX_CONCURRENCY=4
